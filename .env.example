# ============================================
# The 3AM Channel - Environment Configuration
# ============================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values below
# 3. NEVER commit .env to version control
# ============================================

# ── Application ─────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (MongoDB Atlas) ─────────────────
# Get this from MongoDB Atlas → your cluster → Connect → Drivers
MONGODB_URI= mongodb+srv://prateeksingh8871055924_db_user:<db_password>@cluster0.51kouic.mongodb.net/?appName=Cluster0

# ── Logging ──────────────────────────────────
LOG_LEVEL=info
# Options: error | warn | info | http | verbose | debug

# ── Rate Limiting ────────────────────────────
# Global: 100 requests per 15 minutes per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Post creation: 10 posts per night per IP
POST_RATE_LIMIT_WINDOW_MS=60000
POST_RATE_LIMIT_MAX=10

# ── CORS ─────────────────────────────────────
# Development: allow all origins
CORS_ORIGIN=*
# Production: restrict to your domain(s), comma-separated:
# CORS_ORIGIN=https://3amchannel.com,https://www.3amchannel.com

# ── Cleanup Schedule (cron syntax) ───────────
# Default: 6:05 AM daily (5 min after channel closes)
CLEANUP_CRON=5 6 * * *

# ── Optional: Error Tracking ─────────────────
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# ── Admin ─────────────────────────────────────
# Secret key to access admin-only routes:
#   GET  /api/admin/reported   — view reported posts
#   DELETE /api/admin/posts/:id — delete a post
# Set this to a long random string in production.
# Example: openssl rand -hex 32
ADMIN_KEY=change-me-to-a-long-random-secret

# ── Dev Override ──────────────────────────────
# Set to true to bypass the 3AM–6AM time window in development.
# ONLY active when NODE_ENV=development. Ignored in production.
# When true AND MONGODB_URI is missing, the server runs on in-memory
# storage (posts reset on restart, but everything else works).
DEV_OVERRIDE=true
