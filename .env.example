# ============================================
# The 3AM Channel - Environment Configuration
# ============================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values below
# 3. NEVER commit .env to version control
# ============================================

# ── Application ─────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (MongoDB Atlas) ─────────────────
# Leave empty for in-memory storage in development.
# Required in production.
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/3am?retryWrites=true&w=majority
MONGODB_URI=

# ── Logging ──────────────────────────────────
LOG_LEVEL=info

# ── Rate Limiting ────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
POST_RATE_LIMIT_WINDOW_MS=60000
POST_RATE_LIMIT_MAX=10

# ── CORS ─────────────────────────────────────
CORS_ORIGIN=*

# ── Cleanup Schedule (cron) ──────────────────
CLEANUP_CRON=5 6 * * *

# ── Admin ─────────────────────────────────────
# openssl rand -hex 32
ADMIN_KEY=change-me-to-a-long-random-secret

# ── Dev Override ──────────────────────────────
# Bypass the 1AM–6AM time window (only works when NODE_ENV=development)
DEV_OVERRIDE=true
